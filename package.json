{
  "name": "@adnanmk-1999/behavior-tree-viewer",
  "version": "0.1.0",
  "description": "A Vue 3 viewer for BehaviorTree.CPP trees and execution statuses.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adnanmk-1999/behavior-tree-visualizer.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist-library/index.js",
    "dist-library/index.d.ts",
    "dist-library/style.css",
    "dist-library/components/BehaviorTreeViewer.vue.d.ts",
    "dist-library/components/BehaviorTreePlayer.vue.d.ts",
    "dist-library/utils/parseBehaviorTree.d.ts",
    "dist-library/utils/parseBehaviorTreeEvents.d.ts",
    "dist-library/types/*.d.ts",
    "public/licenses/material-design-icons.txt"
  ],
  "main": "./dist-library/index.js",
  "types": "./dist-library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-library/index.d.ts",
      "import": "./dist-library/index.js"
    },
    "./style.css": "./dist-library/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "type-check": "vue-tsc --build",
    "test": "node --test tests/*.test.mjs",
    "test:package": "npm run build:lib && node --test tests/package/*.test.mjs",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@vue-flow/core": "^1.48.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
